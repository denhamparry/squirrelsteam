---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Card from "../components/Card.astro";
import {
  formatDay,
  formatWhen,
  getTourFixtures,
  formatLongDate,
  getUpcomingFixtures,
  isPastDay,
  recurrenceText,
  upcomingOccurrence,
} from "../lib/fixtures";

const now = new Date();
const tourFixtures = (await getTourFixtures()).filter(
  (fixture) => !isPastDay(fixture.data.end ?? fixture.data.start, now),
);
// One-off key dates drop off once they've passed (#296); add new ones here.
const keyDates = [
  { label: "26/27 season starts", date: new Date("2026-09-06") },
].filter(({ date }) => !isPastDay(date, now));
// Only current or upcoming training, so finished sessions and old venues drop off.
const trainingFixtures = (await getUpcomingFixtures()).filter(
  (fixture) => fixture.data.type === "training",
);
const trainingLocations = [
  ...new Set(
    trainingFixtures.flatMap((fixture) =>
      fixture.data.location ? [fixture.data.location] : [],
    ),
  ),
];
const trainingSchedules = trainingFixtures.map((fixture) => ({
  fixture,
  recurrence: fixture.data.rrule
    ? recurrenceText(fixture.data.rrule)
    : null,
  next: upcomingOccurrence(fixture),
  // Upcoming skipped sessions (exdates), e.g. the Christmas break (#297).
  skipped: (fixture.data.exdates ?? [])
    .filter((date) => date.getTime() >= now.getTime())
    .sort((a, b) => a.getTime() - b.getTime())
    .map(formatDay),
}));
---

<BaseLayout
  title="Training"
  description="Rhiwbina Squirrels U12 training times, venue and key season dates."
>
  <PageHeader
    eyebrow="Season 26/27"
    title="Training & key dates"
    lead="Where and when we train, and the dates to put in your diary."
  />
  <section class="section">
    <div class="container container-narrow flow">
      <Card title="Training" headingLevel="h2">
        <ul>
          {
            trainingLocations.map((location) => (
              <li>Venue: <strong>{location}</strong></li>
            ))
          }
          {
            trainingSchedules.map(({ fixture, recurrence, next, skipped }) => (
              <li>
                <strong>{fixture.data.title}</strong> —{" "}
                {recurrence ?? formatWhen(fixture)}
                {next && <>. Next session: {formatWhen(fixture, next)}</>}
                {skipped.length > 0 && (
                  <>. No training on {skipped.join("; ")}</>
                )}
              </li>
            ))
          }
        </ul>
      </Card>

      <Card title="Key dates: season & tour" headingLevel="h2">
        <ul>
          {
            keyDates.map(({ label, date }) => (
              <li>
                <strong>{label}</strong> — {formatLongDate(date)}
              </li>
            ))
          }
          {
            tourFixtures.map((fixture) => (
              <li>
                <a href="/tour/"><strong>{fixture.data.title}</strong></a> — {
                  formatWhen(fixture)
                }
              </li>
            ))
          }
        </ul>
        <p>
          <a class="button button--outline" href="/fixtures/"
            >Add these to your calendar</a
          >
        </p>
      </Card>
    </div>
  </section>
</BaseLayout>
