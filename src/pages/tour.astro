---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Card from "../components/Card.astro";
import {
  formatLongDate,
  formatWhen,
  getTourFixtures,
  isPastDay,
} from "../lib/fixtures";

const [tourFixture] = await getTourFixtures();

if (!tourFixture?.data.location) {
  throw new Error("The published tour fixture must include a location");
}

const tourDate = formatWhen(tourFixture);
const destination = tourFixture.data.location;
const inclusions = [
  "Flights",
  "Accommodation",
  "A rugby game against a local team",
  "Watching a local top-flight rugby match",
  "Waterpark",
];
// Deadlines are real dates so passed ones are marked at build time (#296); the
// site rebuilds daily (#292).
const now = new Date();
const paymentPlan = [
  { amount: "£100", deadline: new Date("2026-11-02") },
  { amount: "£200", deadline: new Date("2027-02-01") },
  { amount: "£300", deadline: new Date("2027-04-05") },
].map((step) => ({
  ...step,
  label: formatLongDate(step.deadline),
  passed: isPastDay(step.deadline, now),
}));
const anyPassed = paymentPlan.some((step) => step.passed);
---

<BaseLayout
  title="Tour — Nice 2027"
  description="Rhiwbina Squirrels U12 tour to Nice, France: dates, what's included and the payment plan."
>
  <PageHeader
    eyebrow="Nice 2027"
    title="Squirrels on Tour"
    lead="Everything Rhiwbina Squirrels #1415 families need to plan for the tour."
  />
  <section class="section">
    <div class="container container-narrow flow">
      <Card title="When & where" headingLevel="h2">
        <dl class="tour-facts">
          <div>
            <dt>Dates</dt>
            <dd>{tourDate}</dd>
          </div>
          <div>
            <dt>Destination</dt>
            <dd>{destination}</dd>
          </div>
        </dl>
      </Card>

      <Card title="What's included" headingLevel="h2">
        <p><strong>£300 per person</strong> includes:</p>
        <ul>
          {inclusions.map((item) => <li>{item}</li>)}
        </ul>
      </Card>

      <Card title="Payment plan" headingLevel="h2">
        <p>
          Each amount is the total paid per person by that date. The full price
          is £300.
        </p>
        <ol class="payment-plan">
          {
            paymentPlan.map(({ amount, label, passed }) => (
              <li class:list={{ "payment-plan__passed": passed }}>
                <strong>{amount}</strong> by {label}
                {passed && <span class="payment-plan__status"> — date passed</span>}
              </li>
            ))
          }
        </ol>
        {
          anyPassed && (
            <p class="muted">
              Missed an instalment? Speak to the team manager and we'll sort out
              the rest of your plan.
            </p>
          )
        }
      </Card>

      <Card title="How to pay" headingLevel="h2">
        <p>
          For bank details and your payment reference, ask the team manager or
          check the team WhatsApp group.
        </p>
      </Card>

      <Card title="Fixture & calendar" headingLevel="h2">
        <p>
          The tour is included with the team's other fixtures and key dates.
        </p>
        <p>
          <a class="button button--outline" href="/fixtures/"
            >Add the tour to your calendar</a
          >
        </p>
      </Card>
    </div>
  </section>
</BaseLayout>

<style>
  .tour-facts {
    display: grid;
    gap: var(--space-s);
  }
  .tour-facts div {
    display: grid;
    gap: var(--space-3xs);
  }
  .tour-facts dt {
    color: var(--color-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .tour-facts dd {
    margin: 0;
    font-weight: 700;
  }
  .payment-plan {
    display: grid;
    gap: var(--space-2xs);
  }
  .payment-plan__passed {
    color: var(--color-muted);
  }
  .payment-plan__status {
    font-size: var(--step--1);
  }
  .muted {
    color: var(--color-muted);
    font-size: var(--step--1);
  }
</style>
