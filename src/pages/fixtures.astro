---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Card from "../components/Card.astro";
import SubscribeButtons from "../components/SubscribeButtons.astro";
import FixtureItem from "../components/FixtureItem.astro";
import {
  calculateSeasonRecord,
  getUpcomingFixtures,
  getPastFixtures,
  getResults,
  type Fixture,
} from "../lib/fixtures";

const showsOnFixturesPage = (fixture: Fixture) =>
  fixture.data.showOnFixturesPage ??
  !(fixture.data.type === "training" && fixture.data.rrule);

const now = new Date();
const upcoming = (await getUpcomingFixtures(now)).filter(showsOnFixturesPage);
const results = (await getResults(now)).filter(showsOnFixturesPage);
const resultIds = new Set(results.map((fixture) => fixture.id));
const past = (await getPastFixtures(now)).filter(
  (fixture) => showsOnFixturesPage(fixture) && !resultIds.has(fixture.id),
);
const record = calculateSeasonRecord(results);
---

<BaseLayout
  title="Fixtures"
  description="Upcoming Rhiwbina Squirrels U12 fixtures and latest results — subscribe to add fixtures to your calendar."
>
  <PageHeader
    eyebrow="Season 26/27"
    title="Fixtures & calendar"
    lead="Upcoming games and events, plus the latest results. Subscribe once and fixtures will keep updating in your calendar."
  />

  <section class="section">
    <div class="container container-narrow flow">
      <Card title="Subscribe to the calendar">
        <p>
          Add the fixtures to your phone or computer. They'll update
          automatically whenever the schedule changes — no need to re-add
          anything.
        </p>
        <SubscribeButtons />
        <details class="help">
          <summary>How do I subscribe on my phone?</summary>
          <div class="flow">
            <p>
              <strong>iPhone / iPad:</strong> tap <em>Apple Calendar</em> above and
              confirm — it opens the Calendar app and adds the feed.
            </p>
            <p>
              <strong>Android:</strong> tap <em>Google Calendar</em>, sign in if
              asked, then confirm <em>Add calendar</em>.
            </p>
            <p>
              Prefer to paste it yourself? Use <em>Copy feed link</em> and add it
              as a subscribed/"from URL" calendar.
            </p>
          </div>
        </details>
      </Card>

      <div id="results" class="fixture-tabs" data-fixtures-tabs>
        <div
          class="fixture-tabs__list"
          role="tablist"
          aria-label="Fixtures"
          data-tab-list
          hidden
        >
          <button
            id="fixtures-tab-upcoming"
            class="fixture-tabs__tab"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="upcoming"
            tabindex="0"
            data-tab="upcoming"
          >
            Upcoming
          </button>
          <button
            id="fixtures-tab-results"
            class="fixture-tabs__tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="results-panel"
            tabindex="-1"
            data-tab="results"
          >
            Results
          </button>
        </div>

        <section
          id="upcoming"
          class="fixture-tabs__panel flow"
          role="tabpanel"
          aria-labelledby="fixtures-tab-upcoming"
          data-tab-panel="upcoming"
        >
          <h2>Upcoming</h2>
          {
            upcoming.length === 0 ? (
              <p class="muted">No upcoming fixtures yet — check back soon.</p>
            ) : (
              <ul class="fixtures" role="list">
                {upcoming.map((f) => (
                  <FixtureItem fixture={f} />
                ))}
              </ul>
            )
          }
        </section>

        <section
          id="results-panel"
          class="fixture-tabs__panel flow"
          role="tabpanel"
          aria-labelledby="fixtures-tab-results"
          data-tab-panel="results"
        >
          <h2>Results</h2>
          {
            results.length === 0 ? (
              <p class="muted">No results recorded yet — check back soon.</p>
            ) : (
              <>
                <dl class="season-record" aria-label="Season record">
                  <div>
                    <dt>Played</dt>
                    <dd>{record.played}</dd>
                  </div>
                  <div>
                    <dt>Won</dt>
                    <dd>{record.won}</dd>
                  </div>
                  <div>
                    <dt>Drawn</dt>
                    <dd>{record.drawn}</dd>
                  </div>
                  <div>
                    <dt>Lost</dt>
                    <dd>{record.lost}</dd>
                  </div>
                  <div>
                    <dt>Points for–against</dt>
                    <dd>{record.pointsFor}–{record.pointsAgainst}</dd>
                  </div>
                </dl>
                <ul class="fixtures" role="list">
                  {results.map((f) => (
                    <FixtureItem fixture={f} showResultDetails />
                  ))}
                </ul>
              </>
            )
          }

          {
            past.length > 0 && (
              <details class="past">
                <summary>Past events ({past.length})</summary>
                <ul class="fixtures" role="list">
                  {past.map((f) => (
                    <FixtureItem fixture={f} showNotes={false} dimmed />
                  ))}
                </ul>
              </details>
            )
          }
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .muted {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .help {
    margin-top: var(--space-s);
    font-size: var(--step--1);
  }
  .help summary,
  .past summary {
    cursor: pointer;
    font-weight: 600;
  }
  .help[open] summary,
  .past[open] summary {
    margin-bottom: var(--space-2xs);
  }

  .fixtures {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }

  .fixture-tabs {
    display: grid;
    gap: var(--space-l);
    scroll-margin-top: calc(4.25rem + var(--space-s));
  }
  .fixture-tabs__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--color-line-dark);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .fixture-tabs__list[hidden] {
    display: none;
  }
  .fixture-tabs__tab {
    min-width: 0;
    border: 0;
    border-radius: 0;
    padding: var(--space-s);
    background: var(--color-white);
    color: var(--color-black);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .fixture-tabs__tab + .fixture-tabs__tab {
    border-left: 1px solid var(--color-line-dark);
  }
  .fixture-tabs__tab[aria-selected="true"] {
    background: var(--color-black);
    color: var(--color-white);
  }
  .fixture-tabs__tab:focus-visible {
    outline-offset: -4px;
  }
  .fixture-tabs__panel {
    min-width: 0;
  }

  .season-record {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-line-dark);
    border-radius: var(--radius);
    background: var(--color-line-dark);
  }
  .season-record div {
    min-width: 0;
    padding: var(--space-s);
    background: var(--color-white);
  }
  .season-record dt {
    color: var(--color-muted);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }
  .season-record dd {
    margin: var(--space-3xs) 0 0;
    font-size: var(--step-1);
    font-weight: 800;
  }
  .season-record div:last-child {
    grid-column: 1 / -1;
  }

  @media (min-width: 38rem) {
    .season-record {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .season-record div:last-child {
      grid-column: auto;
    }
  }

  .past {
    margin-top: var(--space-l);
  }
  .past[open] {
    margin-bottom: var(--space-s);
  }
</style>

<script>
  const fixtureTabs = document.querySelector<HTMLElement>("[data-fixtures-tabs]");

  if (fixtureTabs) {
    const tabList = fixtureTabs.querySelector<HTMLElement>("[data-tab-list]");
    const tabs = Array.from(
      fixtureTabs.querySelectorAll<HTMLButtonElement>("[role='tab']"),
    );
    const panels = Array.from(
      fixtureTabs.querySelectorAll<HTMLElement>("[role='tabpanel']"),
    );

    const selectTab = (tabName: string, moveFocus = false) => {
      const selected = tabs.find((tab) => tab.dataset.tab === tabName) ?? tabs[0];
      if (!selected) return;

      for (const tab of tabs) {
        const active = tab === selected;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.tabPanel !== selected.dataset.tab;
      }
      if (moveFocus) selected.focus({ preventScroll: true });
    };

    const tabFromHash = () =>
      window.location.hash.toLowerCase() === "#results" ? "results" : "upcoming";

    if (tabList && tabs.length > 0 && panels.length > 0) {
      tabList.hidden = false;
      const initialTab = tabFromHash();
      selectTab(initialTab);
      if (initialTab === "results") {
        const focusSelectedTab = () => selectTab(tabFromHash(), true);
        if (document.readyState === "complete") {
          requestAnimationFrame(focusSelectedTab);
        } else {
          window.addEventListener("load", focusSelectedTab, { once: true });
        }
      }

      for (const [index, tab] of tabs.entries()) {
        tab.addEventListener("click", () => {
          const tabName = tab.dataset.tab ?? "upcoming";
          selectTab(tabName);
          const url = new URL(window.location.href);
          url.hash = tabName === "results" ? "results" : "";
          history.replaceState(null, "", url);
        });

        tab.addEventListener("keydown", (event) => {
          let nextIndex: number | null = null;
          if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
          if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
          if (event.key === "Home") nextIndex = 0;
          if (event.key === "End") nextIndex = tabs.length - 1;
          if (nextIndex === null) return;

          event.preventDefault();
          const nextTab = tabs[nextIndex];
          if (nextTab) selectTab(nextTab.dataset.tab ?? "upcoming", true);
        });
      }

      window.addEventListener("hashchange", () => selectTab(tabFromHash(), true));
    }
  }
</script>
