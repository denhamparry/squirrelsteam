---
import { Image } from "astro:assets";
import { sponsorTiers } from "../data/sponsors";
---

<section class="sponsor-band" aria-labelledby="sponsor-band-heading">
  <div class="container">
    <h2 id="sponsor-band-heading" class="sponsor-band__heading">
      Our sponsors
    </h2>
    {
      sponsorTiers.map(({ tier, label, sponsors }) => (
        <div
          class:list={[
            "sponsor-band__group",
            `sponsor-band__group--${tier}`,
          ]}
        >
          <h3
            id={`sponsor-band-${tier}-heading`}
            class="sponsor-band__group-heading"
          >
            {label}
          </h3>
          <ul
            class:list={[
              "sponsor-band__list",
              `sponsor-band__list--${tier}`,
            ]}
            aria-labelledby={`sponsor-band-${tier}-heading`}
            role="list"
          >
            {sponsors.map((sponsor) => (
              <li class="sponsor-band__item">
                {sponsor.url ? (
                  <a
                    class="sponsor-band__link"
                    href={sponsor.url}
                    rel="noopener sponsored"
                  >
                    <Image
                      class="sponsor-band__logo"
                      src={sponsor.logoLight}
                      alt={sponsor.name}
                      width={sponsor.logoLight.width}
                      height={sponsor.logoLight.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <Image
                    class="sponsor-band__logo"
                    src={sponsor.logoLight}
                    alt={sponsor.name}
                    width={sponsor.logoLight.width}
                    height={sponsor.logoLight.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .sponsor-band {
    margin-bottom: var(--space-l);
    padding-bottom: var(--space-l);
    border-bottom: 1px solid var(--color-line-dark);
  }
  .sponsor-band__heading {
    margin-bottom: var(--space-m);
    color: var(--color-white);
    font-size: var(--step-1);
    text-align: center;
  }
  .sponsor-band__group + .sponsor-band__group {
    margin-top: var(--space-m);
  }
  .sponsor-band__group-heading {
    margin-bottom: var(--space-s);
    color: var(--color-white);
    font-size: var(--step--1);
    text-align: center;
  }
  .sponsor-band__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }
  .sponsor-band__list--secondary {
    max-width: 32rem;
    margin-inline: auto;
  }
  .sponsor-band__item {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
  }
  .sponsor-band__link {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
  }
  .sponsor-band__logo {
    width: 100%;
    height: 4rem;
    object-fit: contain;
  }
  .sponsor-band__group--secondary .sponsor-band__logo {
    height: 2.75rem;
  }

  @media (min-width: 36rem) {
    .sponsor-band__list {
      gap: var(--space-m);
    }
  }

  @media (min-width: 64rem) {
    .sponsor-band__list--primary {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
