---
interface Props {
  title?: string;
  href?: string;
  /** Pick the level that fits the page outline (no skipped levels, #302). */
  headingLevel?: "h2" | "h3" | "h4";
  /**
   * An h2 card title is sized like an h3 by default, so choosing the right
   * heading level doesn't change how the card looks. "section" keeps the full
   * h2 size for cards that act as page sections (e.g. the Code of Conduct).
   */
  titleSize?: "card" | "section";
}
const { title, href, headingLevel = "h3", titleSize = "card" } = Astro.props;
const compactTitle = headingLevel === "h2" && titleSize === "card";
const Tag = href ? "a" : "div";
const Heading = headingLevel;
---

<Tag class:list={["card", { "card--link": href }]} href={href}>
  {
    title && (
      <Heading class:list={["card__title", { "card__title--compact": compactTitle }]}>
        {title}
      </Heading>
    )
  }
  <div class="card__body flow">
    <slot />
  </div>
</Tag>

<style>
  .card {
    display: block;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: var(--space-m);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
  }
  .card--link {
    transition:
      transform var(--transition),
      border-color var(--transition);
  }
  .card--link:hover {
    transform: translateY(-2px);
    border-color: var(--color-black);
  }
  .card__title {
    margin-bottom: var(--space-2xs);
  }
  .card__title--compact {
    font-size: var(--step-1);
  }
</style>
