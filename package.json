{
  "name": "squirrels-team-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website for the Rhiwbina Squirrels U12 (#1415) rugby team",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --plugin=prettier-plugin-astro --write \"src/**/*.{astro,ts,mjs,css}\" \"test/**/*.ts\" astro.config.mjs",
    "format:check": "prettier --plugin=prettier-plugin-astro --check \"src/**/*.{astro,ts,mjs,css}\" \"test/**/*.ts\" astro.config.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
